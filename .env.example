# Shared OpenAI-compatible 9Router configuration.
# Copy to .env only if your launcher loads dotenv, or set these in Windows user environment.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=ms/GPT-5.6-Think-Deeper
LLM_TIMEOUT=60

# OPENAI_* aliases are supported when LLM_* is absent.
# OPENAI_BASE_URL=http://localhost:20128/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=ms/GPT-5.6-Think-Deeper

# Video Studio web research (Riset web). Order: Tavily first, Google grounding as fallback.
# Tavily: set TAVILY_API_KEY directly, or add a Tavily key in 9Router (Providers > Tavily);
# the dashboard then calls 9Router /v1/search with provider "tavily".
TAVILY_API_KEY=
# Google Search grounding fallback: set exactly one of these locally.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
VIDEO_RESEARCH_MODEL=gemini-2.5-flash
