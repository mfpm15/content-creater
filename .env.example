# Shared OpenAI-compatible 9Router configuration.
# Copy to .env only if your launcher loads dotenv, or set these in Windows user environment.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=ag/gemini-3.8-flash-medium
LLM_TIMEOUT=60

# OPENAI_* aliases are supported when LLM_* is absent.
# OPENAI_BASE_URL=http://localhost:20128/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=ag/gemini-3.8-flash-medium

# Required by Video Studio for Google Search grounded research.
# Obtain a Gemini Developer API key and set exactly one of these locally.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
VIDEO_RESEARCH_MODEL=gemini-2.5-flash
