# Shared OpenAI-compatible 9Router configuration.
# Copy to .env; the dashboard loads it at startup (values already in the environment win).
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=cc/claude-sonnet-5-5
LLM_TIMEOUT=60

# OPENAI_* aliases are supported when LLM_* is absent.
# OPENAI_BASE_URL=http://localhost:20128/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=cc/claude-sonnet-5-5

# Web research (Video Studio "Riset web" and Article Drafter) uses Tavily directly.
# Keep the key only in your local .env (ignored by Git).
TAVILY_API_KEY=
