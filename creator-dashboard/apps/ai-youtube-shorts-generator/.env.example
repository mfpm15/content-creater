# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # Gunakan openai untuk endpoint OpenAI-compatible seperti 9Router
OPENAI_API_KEY=your_9router_key_here
OPENAI_BASE_URL=https://your-9router-openai-compatible-base-url/v1
OPENAI_MODEL=ag/gemini-3.8-flash-medium
# Alternatif kualitas lebih tinggi: ag/gemini-3.8-flash-high
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
